<!-- ManiBox R16 시뮬레이션 모델. 프레임 기둥 +200mm, 그리퍼 대신 직접 설계한 흡착 공구(assets/tool/suction_tool_ABC.stl). 손으로 고쳐 쓰는 파일이다. -->
<mujoco model="manibox_r16_tall">
  <compiler angle="radian" meshdir="../assets" autolimits="true"/>
  <option timestep="0.002" integrator="implicitfast" cone="elliptic" impratio="10"/>
  <size memory="64M"/>

  <visual>
    <global offwidth="1280" offheight="670" azimuth="-31.13" elevation="-1.67"/>
    <headlight ambient="0.35 0.35 0.35" diffuse="0.6 0.6 0.6" specular="0.1 0.1 0.1"/>
    <quality shadowsize="4096"/>
  </visual>
  <!-- 뷰어를 열었을 때의 시점이 아래 카메라 "view" 와 같아지도록 맞춘 값 (거리 = 1.5 x extent) -->
  <statistic center="0.800 0.316 0.273" extent="1.419"/>

  <default>
    <!-- 충돌 비트: 1=프레임/바닥/물체, 2=캐리지, 4=팔. 프레임과 캐리지는 서로 충돌하지 않는다(레일 위를 미끄러짐). -->
    <default class="visual">
      <geom type="mesh" contype="0" conaffinity="0" group="2" density="0"/>
    </default>
    <default class="frame_col">
      <!-- 실제 충돌·시각 통합. aluminum 재질, group=2 (뷰어 기본 표시). STL 메시(frame_visual) 는 숨김 — 옛 가로대 위치가 구워져 있어서 혼동 유발. -->
      <geom contype="1" conaffinity="0" group="2" material="aluminum"/>
    </default>
    <default class="carriage_col">
      <geom contype="2" conaffinity="0" group="3" rgba="0.9 0.6 0.3 0.3"/>
    </default>
    <default class="arm">
      <geom type="mesh" contype="4" conaffinity="7" group="2" rgba="0.85 0.86 0.88 1"/>
      <default class="arm_big">
        <joint axis="0 0 1" armature="0.1" damping="2" frictionloss="0.1"/>
        <position kp="300" kv="30" forcerange="-100 100"/>
      </default>
      <default class="arm_small">
        <joint axis="0 0 1" armature="0.05" damping="1" frictionloss="0.05"/>
        <position kp="100" kv="6" forcerange="-30 30"/>
      </default>
    </default>
  </default>

