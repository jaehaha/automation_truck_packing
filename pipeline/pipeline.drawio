        <mxCell id="s0a" value="&lt;b&gt;0. 상자 시퀀스 입력&lt;/b&gt;&#10;[id1, id2, …, idn] + 종류/하차지점" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1f4d12;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="218" width="430" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="s0b" value="&lt;b&gt;manager/main.py&lt;/b&gt;&#10;load_manifest(moves.json)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1f4d12;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="480" y="218" width="430" height="60" as="geometry"/>
