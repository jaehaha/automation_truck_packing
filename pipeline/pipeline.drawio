        <mxCell id="pre" value="&lt;b&gt;사전 (한 번만)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=#fafafa;align=left;verticalAlign=middle;fontSize=12;fontColor=#555555;" vertex="1" parent="1">
