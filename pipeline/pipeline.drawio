<mxfile host="app.diagrams.net"><diagram id="pipeline" name="Pipeline"><mxGraphModel dx="1440" dy="860" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="860" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="ManiBox 적재 전체 파이프라인" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=26;fontColor=#222222;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="24" width="700" height="34" as="geometry"/></mxCell><mxCell id="c3" value="Packing Model 이 정한 순서대로 하나씩 경로를 계획해 실행하고, 끝날 때마다 상자 표를 갱신한다" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=15;fontColor=#666666;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="60" y="60" width="900" height="24" as="geometry"/></mxCell><mxCell id="c4" value='&lt;span style="font-size:17px"&gt;상자 목록 [id1, id2, …, idn]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:13px;color:#666666"&gt;id, 하차 지점, 종류&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f4f4f4;strokeColor=#999999;fontColor=#222222;fontSize=14;" vertex="1" parent="1"><mxGeometry x="560" y="100" width="280" height="60" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b style="font-size:21px"&gt;Packing Model&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;학습된 적재 정책 (handoff, plan_moves.py)&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f6c6ad;strokeColor=#d9906a;fontColor=#5a2d14;fontSize=14;" vertex="1" parent="1"><mxGeometry x="560" y="198" width="280" height="84" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b style="font-size:15px;color:#5a2d14"&gt;놓는 순서 목록&lt;/b&gt;&lt;br&gt;[ id1 : goal pos ]&lt;br&gt;[ id2 : goal pos ]&lt;br&gt;… [ idn : goal pos ]' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff6f0;strokeColor=#d9906a;fontColor=#333333;fontSize=14;" vertex="1" parent="1"><mxGeometry x="560" y="320" width="280" height="104" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b style="font-size:21px"&gt;Motion Planning&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;sim_final Stacker.plan (휴리스틱 + 충돌 검사)&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#b9e3a8;strokeColor=#6fae58;fontColor=#1f4d12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="560" y="500" width="280" height="92" as="geometry"/></mxCell><mxCell id="c8" value='&lt;b style="font-size:17px"&gt;카메라 (ArUco 마커)&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;전체뷰: 상자 도착·종류 확인&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;손목: 집기 직전 정밀 측정&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eef3f8;strokeColor=#8aa5c2;fontColor=#1d3b5c;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="270" width="340" height="92" as="geometry"/></mxCell><mxCell id="c9" value='&lt;b style="font-size:17px"&gt;상자 표 (BoxTable)&lt;/b&gt;&lt;br&gt;id1 : { box size, current position }&lt;br&gt;id2 : { box size, current position }&lt;br&gt;…&lt;br&gt;idn : { box size, current position }' style="rounded=0;arcSize=12;whiteSpace=wrap;html=1;fillColor=#a9c9ec;strokeColor=#2f5d94;fontColor=#12304f;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="470" width="340" height="152" as="geometry"/></mxCell><mxCell id="c10" value='&lt;b style="font-size:21px"&gt;실행&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;Robot.follow / suction&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e9e2f5;strokeColor=#8d78b8;fontColor=#35235c;fontSize=14;" vertex="1" parent="1"><mxGeometry x="960" y="500" width="200" height="92" as="geometry"/></mxCell><mxCell id="c11" value='&lt;span style="font-size:15px"&gt;Piper 팔&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#666666"&gt;CAN&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f4f4f4;strokeColor=#999999;fontColor=#222222;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1230" y="430" width="170" height="52" as="geometry"/></mxCell><mxCell id="c12" value='&lt;span style="font-size:15px"&gt;리니어 레일&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#666666"&gt;아두이노&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f4f4f4;strokeColor=#999999;fontColor=#222222;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1230" y="520" width="170" height="52" as="geometry"/></mxCell><mxCell id="c13" value='&lt;span style="font-size:15px"&gt;흡착 밸브&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#666666"&gt;아두이노 (솔레노이드)&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f4f4f4;strokeColor=#999999;fontColor=#222222;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1230" y="610" width="170" height="52" as="geometry"/></mxCell><mxCell id="c14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#444444;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#444444;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#444444;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="순차 탐색&lt;br&gt;(앞에서부터 하나씩)" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;whiteSpace=wrap;fontSize=13