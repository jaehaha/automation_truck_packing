        </mxCell>

        <mxCell id="s_box" value="&lt;b&gt;BoxTable 초기화&lt;/b&gt;&#10;id → {size, current, goal, state=pending}" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1f4d12;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="370" width="430" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="s_box_b" value="&lt;b&gt;manager/boxes.py&lt;/b&gt;&#10;BoxTable.add(id, size), set_goal(id, goal)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1f4d12;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="480" y="370" width="430" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="s_box_c" value="—" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="920" y="370" width="430" height="56" as="geometry"/>
        </mxCell>

        <mxCell id="loop_banner" value="&lt;b&gt;LOOP — 상자 하나씩 (manager/main.py :88 for)&lt;/b&gt;" style="text;html=1;strokeColor=#cccccc;fillColor=#fff9e6;align=center;verticalAlign=middle;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="450" width="1310" height="28" as="geometry"/>
        </mxCell>

        <mxCell id="s2a" value="&lt;b&gt;2. 사람이 투입 (수동)&lt;/b&gt;&#10;투입 위치 (85, 240)&#10;상자 윗면 ArUco 마커 중앙에 정렬" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#5a4210;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="490" width="430" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="s2b" value="&lt;b&gt;코드엔 없음 (수동 작업)&lt;/b&gt;&#10;modules/mp/stacking.py :37 PICK_XY 가 이 위치의 좌표계 기준값 — 컨테이너 좌표계 통일 시 업데이트 필요" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#5a4210;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="480" y="490" width="430" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="s2c" value="사람" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="920" y="490" width="430" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="s3a" value="&lt;b&gt;3-a. 손목 카메라 오차 측정&lt;/b&gt;&#10;ArUco 로 dx, dy, yaw 측정 → BoxTable.set_current(측정값)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#5a1210;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="580" width="430" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="s3b" value="&lt;b&gt;robot.measure_box()&lt;/b&gt;&#10;manager/robot.py :106 — 현재는 더미 (0, 0, 0) 반환&#10;RealCamera (OpenCV + ArUco) 미구현" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#5a1210;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="480" y="580" width="430" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="s3c" value="&lt;b&gt;손목 카메라&lt;/b&gt; (USB)&#10;modules/camera/camera.py — RealCamera" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#5a1210;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="920" y="580" width="430" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="s3b2" value="&lt;b&gt;3-b. Motion Planning — 경로 생성&lt;/b&gt;&#10;4단계: 집기 → 이송 자세 → 레일 → 놓기&#10;Plan(approach, carry, retreat) 반환" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1f4d12;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="670" width="430" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="s3b2b" value="&lt;b&gt;Sequencer.plan(i, goal, size)&lt;/b&gt;&#10;modules/mp/sequence.py :150&#10;_tpl() → _check()&#10;IK·충돌: modules/mp/stacking.py&#10;편집 가능한 규칙: modules/mp/rules.py" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1f4d12;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="480" y="670" width="430" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="s3b2c" value="— (순수 계산)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="920" y="670" width="430" height="78" as="geometry"/>
        </mxCell>

        <mxCell id="sxa" value="&lt;b&gt;실행 — skills.pick_and_place&lt;/b&gt;&#10;manager/skills.py" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#5a4210;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="768" width="430" height="52" as="geometry"/>
        </mxCell>

        <mxCell id="s4a" value="&lt;b&gt;4. 접근&lt;/b&gt;&#10;현재 자세 → 투입 위치 위 (빈손)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#5a4210;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="840" width="430" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="s4b" value="&lt;b&gt;robot.follow(plan.approach)&lt;/b&gt;&#10;manager/robot.py :82&#10;rail.command(q[0]) + arm.command(q[1:7])  (타이밍 A)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#5a4210;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="480" y="840" width="430" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="s4c" value="&lt;b&gt;레일&lt;/b&gt; Arduino M&lt;mm&gt;  (✅)&#10;&lt;b&gt;팔&lt;/b&gt; Piper CAN JointCtrl  (❌)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#5a4210;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="920" y="840" width="430" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="s5a" value="&lt;b&gt;5. 흡착 ON — 상자 집기&lt;/b&gt;&#10;붙을 때까지 대기" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1f4d12;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="920" width="430" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="s5b" value="&lt;b&gt;robot.suction_on()&lt;/b&gt;  →  suction.on()&#10;modules/vacuum/suction.py (RealSuction.on → 'ON\n')" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1f4d12;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="480" y="920" width="430" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="s5c" value="&lt;b&gt;솔레노이드 밸브&lt;/b&gt;&#10;Arduino D7 LOW-Trigger 릴레이" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1f4d12;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="920" y="920" width="430" height="56" as="geometry"/>
        </mxCell>

        <mxCell id="s6a" value="&lt;b&gt;6. 반송 (carry)&lt;/b&gt;&#10;lifting → aligning → rotating → MV_POS → 레일 이동 → 내리기·밀어넣기 → 놓기" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#5a4210;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="996" width="430" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="s6b" value="&lt;b&gt;robot.follow(plan.carry, box_follow=...)&lt;/b&gt;&#10;sim: box_follow 가 상자를 공구에 붙여 시각화&#10;MV_CUP_POS = 0.47 m (modules/mp/stacking.py :44)&#10;레일 명령: '0~1000 mm' 아두이노 좌표" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#5a4210;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="480" y="996" width="430" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="s6c" value="&lt;b&gt;레일&lt;/b&gt; + &lt;b&gt;팔&lt;/b&gt; 동시&#10;Arduino + Piper CAN&#10;(레일 ✅, 팔 ❌)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#5a4210;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="920" y="996" width="430" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="s7a" value="&lt;b&gt;7. 흡착 OFF&lt;/b&gt;&#10;상자 분리" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1f4d12;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="1096" width="430" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="s7b" value="&lt;b&gt;robot.suction_off()&lt;/b&gt;  →  suction.off()&#10;Arduino 'OFF\n' → 밸브 비활성" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1f4d12;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="480" y="1096" width="430" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="s7c" value="&lt;b&gt;솔레노이드 밸브&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1f4d12;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="920" y="1096" width="430" height="56" as="geometry"/>
        </mxCell>

        <mxCell id="s8a" value="&lt;b&gt;8. 후퇴 (retreat) + 레일 0 복귀&lt;/b&gt;&#10;놓은 자세 → MV_POS → 투입 자세&#10;(현재: retreat path 가 담당, home() 명시 선택)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#5a4210;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="1172" width="430" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="s8b" value="&lt;b&gt;robot.follow(plan.retreat)&lt;/b&gt;&#10;(선택) robot.rail.home()  → Arduino 'HOME\n'" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#5a4210;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="480" y="1172" width="430" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="s8c" value="&lt;b&gt;레일&lt;/b&gt; + &lt;b&gt;팔&lt;/b&gt;&#10;(레일 ✅, 팔 ❌)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#5a4210;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="920" y="1172" width="430" height="76" as="geometry"/>
        </mxCell>

        <mxCell id="s9a" value="&lt;b&gt;9. BoxTable 갱신 → 다음 상자 반복&lt;/b&gt;&#10;table.done(id): current = goal, state = placed" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1f4d12;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="1268" width="430" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="s9b" value="&lt;b&gt;table.done(box_id)&lt;/b&gt;  →  main.py for 루프 다음 iteration" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1f4d12;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="480" y="1268" width="430" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="s9c" value="—" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="920" y="1268" width="430" height="56" as="geometry"/>
        </mxCell>

